# vim:ft=make:

CXXFLAGS_OPTIMISATION?=-O2
CXXFLAGS_DEBUG?=-ggdb

# Default sanitiser is for GCC.
# Remember to build without sanitisers if you want to use Valgrind.
CXXFLAGS_SANITISER?=

# No -fstack-protector-all because it slows code down too much.
CXXFLAGS_OPTION?=\
				 -fstrict-aliasing \
				 -fstrict-overflow
