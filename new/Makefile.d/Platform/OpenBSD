# vim:ft=make:

# OpenBSD install some libraries into /usr/local instead of into /usr.
PLATFORM_LIBS=\
    -L /usr/local/lib

# The NT_GNU_BUILD_ID has to be defined ad-hoc, because it is not included in
# the elf.h header supplied by OpenBSD, but we need it to record BuildID
# information.
PLATFORM_MACROS=\
	-DVIUA_OPENBSD \
	-DNT_GNU_BUILD_ID=3

PLATFORM_INCLUDE_FLAGS=\
	-I /usr/local/include

install=ginstall
python3=python3.12
